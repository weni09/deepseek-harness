+/**
+ * Standalone Linux Desktop packager for DeepSeek Harness (deb and AppImage).
+ */
+
+import { spawnSync, execFileSync } from 'node:child_process'
+import {
+  cpSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  readdirSync,
+  rmSync,
+  writeFileSync,
+  chmodSync,
+  copyFileSync,
+  statSync,
+} from 'node:fs'
+import { createHash } from 'node:crypto'
+import { tmpdir } from 'node:os'
+import { basename, delimiter, join, relative, resolve, sep } from 'node:path'
+import { createRequire } from 'node:module'
+const ROOT = resolve(import.meta.dirname, '..')
+const desktopRequire = createRequire(join(ROOT, 'apps', 'desktop', 'package.json'))
+const { downloadArtifact } = desktopRequire('@electron/get')
+const extractZip = desktopRequire('extract-zip')
+
+import { preparePrimaryRuntime, smokePrimaryRuntime } from './primary-runtime/prepare.ts'
+import { selectDesktopPackageClosure, type PackedDesktopPackage } from '../apps/desktop/scripts/prepare-package-set.ts'
+import { parseDesktopRelease } from '../apps/desktop/src/release.ts'
+import {
+  DESKTOP_PACKAGES_DIR,
+  DESKTOP_PACKAGE_SET_FILE,
+  readDesktopCorePackageSet,
+  verifyDesktopCoreLockfile,
+  type DesktopCorePackageRecord,
+} from '../apps/desktop/src/core-package-set.ts'
+import { DESKTOP_HOST_PROTOCOL_VERSION } from '../apps/desktop/src/host-protocol.ts'
+import { createRuntimeProjectMetadata } from '../apps/desktop/src/project-manager.ts'
+import { writeDesktopRuntime, verifyDesktopRuntime } from '../apps/desktop/src/runtime-tree.ts'
+import { selectOfficeEngine, officePackageDirectories } from './libreoffice-packages.mjs'
+import { desktopRuntimeFileExclusion } from '../apps/desktop/scripts/runtime-file-policy.ts'
+import { prepareRuntimeManifests } from '../apps/desktop/scripts/prepare-runtime-manifests.ts'
+import { desktopNodeEnvironment } from '../apps/desktop/src/node-environment.ts'
+
+const DESKTOP_ROOT = join(ROOT, 'apps', 'desktop')
+const BUILD_ROOT = join(DESKTOP_ROOT, '.desktop-build', 'targets', 'linux-x64')
+const ARTIFACTS_DIR = join(ROOT, 'dist', 'desktop')
+const DOWNLOADS_DIR = join(DESKTOP_ROOT, '.desktop-build', 'downloads')
+
+const RUNTIME_ROOT = join(BUILD_ROOT, 'runtime')
+const ELECTRON_DIR = join(BUILD_ROOT, 'electron')
+const DSH_OUTPUT_ROOT = join(BUILD_ROOT, 'dsh')
+const PACKAGE_SET_ROOT = join(BUILD_ROOT, 'package-set')
+const PACKED_ROOT = join(BUILD_ROOT, 'packed')
+const PACKED_DSH = join(PACKED_ROOT, 'dsh')
+const PACKED_VENDOR = join(PACKED_ROOT, 'vendor')
+const PACKED_LANDLOCK = join(PACKED_ROOT, 'landlock')
+
+console.log('==> 1. Setting up directory layout...')
+mkdirSync(BUILD_ROOT, { recursive: true })
+mkdirSync(ARTIFACTS_DIR, { recursive: true })
+mkdirSync(DOWNLOADS_DIR, { recursive: true })
+mkdirSync(PACKED_DSH, { recursive: true })
+mkdirSync(PACKED_VENDOR, { recursive: true })
+mkdirSync(PACKED_LANDLOCK, { recursive: true })
+
+console.log('==> 2. Copying packed tarballs from dist/ ...')
+for (const [directory, label] of [
+  [join(ROOT, 'dist', 'npm'), 'dsh'],
+  [join(ROOT, 'dist', 'npm-vendor'), 'vendor'],
+  [join(ROOT, 'dist', 'npm-landlock'), 'landlock'],
+] as const) {
+  if (!existsSync(directory)) {
+    throw new Error(`Linux desktop packaging needs ${directory}. Build it first:\n`
+      + '  pnpm run build:official\n'
+      + '  pnpm run release:pack --family dsh --out dist/npm\n'
+      + '  pnpm run release:pack --family vendor --out dist/npm-vendor\n'
+      + '  pnpm --dir native/system run build:ts\n'
+      + '  pnpm --dir native/system/packages/entry pack --pack-destination "$PWD/dist/npm-landlock"')
+  }
+  console.log(`    ${label}: ${directory}`)
+}
+cpSync(join(ROOT, 'dist', 'npm'), PACKED_DSH, { recursive: true })
+// Also pack desktop-host into PACKED_DSH
+const packDesktopHost = spawnSync('pnpm', ['--dir', 'apps/desktop-host', 'pack', '--pack-destination', PACKED_DSH], {
+  cwd: ROOT,
+  stdio: 'inherit',
+})
+if (packDesktopHost.status !== 0) throw new Error('Failed to pack apps/desktop-host')
+
+cpSync(join(ROOT, 'dist', 'npm-vendor'), PACKED_VENDOR, { recursive: true })
+cpSync(join(ROOT, 'dist', 'npm-landlock'), PACKED_LANDLOCK, { recursive: true })
+
+console.log('==> 3. Preparing Electron and runtime...')
+const require = createRequire(import.meta.url)
+// Pin the Electron build this packager downloads instead of following the upstream `electron`
+// dependency, whose lockfile entry (44.0.0) ships a Linux tray regression: status icons register
+// with the StatusNotifierWatcher under a combined "<bus-name>/<object-path>" string. Watchers
+// such as ayatana-indicator-application read any argument not starting with "/" as a bus name,
+// so that string fails g_dbus_is_name() and the icon is dropped with no error the application
+// can observe. Electron 44.1.0 restores the bare service name (Chromium 152.0.7977.x,
+// crrev.com/c/8272040); 44.5.1 also carries the dbusmenu object-path fix.
+// Override DSH_ELECTRON_VERSION to move to a newer build without editing this patch.
+const electronVersion = process.env.DSH_ELECTRON_VERSION ?? '44.5.1'
+
+// Re-download unless the cached tree is exactly this Electron version, so a build directory
+// left behind by an older pin cannot silently ship the previous binary.
+const cachedElectronVersion = existsSync(join(ELECTRON_DIR, 'version'))
+  ? readFileSync(join(ELECTRON_DIR, 'version'), 'utf8').trim()
+  : undefined
+if (cachedElectronVersion !== electronVersion) {
+  console.log(`Downloading electron v${electronVersion} for linux-x64...`)
+  const electronArchive = await downloadArtifact({
+    version: electronVersion,
+    platform: 'linux',
+    arch: 'x64',
+    artifactName: 'electron',
+    cacheRoot: DOWNLOADS_DIR,
+    // Only redirect the download when a mirror is configured; the default source is used otherwise.
+    ...(process.env.ELECTRON_MIRROR === undefined || process.env.ELECTRON_MIRROR === ''
+      ? {}
+      : { mirrorOptions: { mirror: process.env.ELECTRON_MIRROR } }),
+  })
+  rmSync(ELECTRON_DIR, { recursive: true, force: true })
+  await extractZip(electronArchive, { dir: ELECTRON_DIR })
+}
+const NODE = join(ELECTRON_DIR, 'electron')
+
+// Prepare pnpm in runtime
+function preparePnpm(): string {
+  const pnpmManifestPath = require.resolve('pnpm')
+  const pnpmManifest = JSON.parse(readFileSync(pnpmManifestPath, 'utf8')) as { version?: unknown }
+  const pnpmDir = resolve(pnpmManifestPath, '..')
+  const pnpmDest = join(RUNTIME_ROOT, 'pnpm')
+  rmSync(pnpmDest, { recursive: true, force: true })
+  cpSync(pnpmDir, pnpmDest, { recursive: true })
+  return pnpmManifest.version as string
+}
+
+rmSync(RUNTIME_ROOT, { recursive: true, force: true })
+mkdirSync(RUNTIME_ROOT, { recursive: true })
+const pnpmVersion = preparePnpm()
+cpSync(join(DESKTOP_ROOT, 'scripts', 'node-bin'), join(RUNTIME_ROOT, 'bin'), { recursive: true })
+chmodSync(join(RUNTIME_ROOT, 'bin', 'node'), 0o755)
+
+// Write versions.json
+const nodeVersion = execFileSync(NODE, ['-p', 'process.versions.node'], {
+  encoding: 'utf8',
+  env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' },
+}).trim()
+
+writeFileSync(join(RUNTIME_ROOT, 'versions.json'), `${JSON.stringify({
+  schemaVersion: 1,
+  node: nodeVersion,
+  pnpm: pnpmVersion,
+}, null, 2)}\n`)
+
+// Prepare primary-runtime (Node, Python, LibreOffice python wheels, office-skills)
+console.log('==> 4. Preparing primary-runtime...')
+const { version: dshVersion } = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8')) as { version: string }
+await preparePrimaryRuntime({
+  target: 'linux-x64',
+  output: RUNTIME_ROOT,
+  cache: DOWNLOADS_DIR,
+  version: dshVersion,
+})
+smokePrimaryRuntime(join(RUNTIME_ROOT, 'primary-runtime'))
+
+// Prepare package set
+console.log('==> 5. Preparing Desktop package set...')
+function packedManifest(tarball: string): Record<string, unknown> {
+  const value: unknown = JSON.parse(execFileSync('tar', ['-xOzf', tarball, 'package/package.json'], { encoding: 'utf8' }))
+  return value as Record<string, unknown>
+}
+
+const available = new Map<string, PackedDesktopPackage>()
+for (const dir of [PACKED_DSH, PACKED_VENDOR, PACKED_LANDLOCK]) {
+  for (const file of readdirSync(dir).filter(f => f.endsWith('.tgz'))) {
+    const tarball = join(dir, file)
+    const manifest = packedManifest(tarball)
+    const name = manifest.name as string
+    if (available.has(name)) continue
+    available.set(name, { tarball, manifest })
+  }
+}
+
+const selected = selectDesktopPackageClosure(available)
+rmSync(PACKAGE_SET_ROOT, { recursive: true, force: true })
+const packageDir = join(PACKAGE_SET_ROOT, DESKTOP_PACKAGES_DIR)
+mkdirSync(packageDir, { recursive: true })
+const records: DesktopCorePackageRecord[] = selected.map((packed) => {
+  const name = packed.manifest.name as string
+  const version = packed.manifest.version as string
+  const file = basename(packed.tarball)
+  const destination = join(packageDir, file)
+  copyFileSync(packed.tarball, destination)
+  const body = readFileSync(destination)
+  return {
+    name,
+    version,
+    file,
+    bytes: statSync(destination).size,
+    integrity: `sha512-${createHash('sha512').update(body).digest('base64')}`,
+  }
+})
+const packageSet = { schemaVersion: 1, packages: records }
+writeFileSync(join(PACKAGE_SET_ROOT, DESKTOP_PACKAGE_SET_FILE), `${JSON.stringify(packageSet, null, 2)}\n`, { mode: 0o600 })
+
+// Reuse materialized DSH runtime if present
+if (existsSync(DSH_OUTPUT_ROOT) && existsSync(join(DSH_OUTPUT_ROOT, 'package.json')) && existsSync(join(DSH_OUTPUT_ROOT, 'node_modules'))) {
+  console.log('==> 7. Reusing already materialized DSH production runtime...')
+} else {
+  console.log('==> 7. Materializing DSH production modules via pnpm install...')
+  const DSH_TEMP_BUILD = mkdtempSync(join(tmpdir(), 'dsh-desktop-linux-'))
+  const STORE_ROOT = join(DSH_TEMP_BUILD, 'store')
+  const PNPM_BUILD_STATE = join(BUILD_ROOT, 'dsh-pnpm')
+  const PNPM = join(RUNTIME_ROOT, 'pnpm', 'bin', 'pnpm.mjs')
+
+  copyFileSync(join(PACKAGE_SET_ROOT, DESKTOP_PACKAGE_SET_FILE), join(DSH_TEMP_BUILD, DESKTOP_PACKAGE_SET_FILE))
+  cpSync(join(PACKAGE_SET_ROOT, DESKTOP_PACKAGES_DIR), join(DSH_TEMP_BUILD, DESKTOP_PACKAGES_DIR), { recursive: true })
+
+  const release = parseDesktopRelease({
+    schemaVersion: 1,
+    version: dshVersion,
+    hostProtocolVersion: DESKTOP_HOST_PROTOCOL_VERSION,
+    nodeVersion,
+    pnpmVersion,
+  })
+  createRuntimeProjectMetadata(DSH_TEMP_BUILD, release)
+
+  const pnpmConfig = join(PNPM_BUILD_STATE, 'config')
+  const userConfig = join(pnpmConfig, 'npmrc')
+  mkdirSync(pnpmConfig, { recursive: true })
+  writeFileSync(userConfig, '')
+
+  function runDshPnpm(args: string[]): void {
+    const res = spawnSync(NODE, [
+      '--expose-internals',
+      PNPM,
+      `--config.store-dir=${STORE_ROOT}`,
+      '--config.enable-global-virtual-store=false',
+      `--config.userconfig=${userConfig}`,
+      ...args,
+    ], {
+      cwd: DSH_TEMP_BUILD,
+      env: {
+        ...Object.fromEntries(Object.entries(process.env).filter(([name]) => (
+          name !== 'NODE_OPTIONS' && name !== 'NODE_PATH' && !/^DSH_DESKTOP_/u.test(name) && !/^(?:npm|pnpm|corepack)_/iu.test(name)
+        ))),
+        NPM_CONFIG_STORE_DIR: STORE_ROOT,
+        NPM_CONFIG_USERCONFIG: userConfig,
+        ...desktopNodeEnvironment(NODE, join(RUNTIME_ROOT, 'bin'), {}),
+        PATH: `${join(RUNTIME_ROOT, 'bin')}${delimiter}${process.env.PATH ?? ''}`,
+        XDG_CACHE_HOME: join(PNPM_BUILD_STATE, 'cache'),
+        XDG_CONFIG_HOME: pnpmConfig,
+        XDG_STATE_HOME: join(PNPM_BUILD_STATE, 'state'),
+      },
+      stdio: 'inherit',
+    })
+    if (res.status !== 0) throw new Error(`pnpm ${args.join(' ')} failed with exit code ${res.status}`)
+  }
+
+  runDshPnpm(['install', '--lockfile-only'])
+  verifyDesktopCoreLockfile(
+    readFileSync(join(DSH_TEMP_BUILD, 'pnpm-lock.yaml'), 'utf8'),
+    readDesktopCorePackageSet(DSH_TEMP_BUILD, release.version),
+  )
+  runDshPnpm(['install', '--prod', '--frozen-lockfile', '--trust-lockfile'])
+
+  const target = { platform: 'linux' as const, arch: 'x64' as const }
+  const modules = join(DSH_TEMP_BUILD, 'node_modules')
+  const officeManifest = JSON.parse(readFileSync(join(modules, '@deepseek-ai/libreoffice-kit/package.json'), 'utf8'))
+  const officeEngine = selectOfficeEngine(officeManifest, target)
+
+  rmSync(DSH_OUTPUT_ROOT, { recursive: true, force: true })
+  mkdirSync(DSH_OUTPUT_ROOT, { recursive: true })
+  cpSync(modules, join(DSH_OUTPUT_ROOT, 'node_modules'), {
+    recursive: true,
+    dereference: true,
+    filter: source => desktopRuntimeFileExclusion(relative(modules, source), target, officeEngine) === undefined,
+  })
+
+  writeFileSync(join(DSH_OUTPUT_ROOT, 'package.json'), `${JSON.stringify({
+    name: '@deepseek-ai/dsh-desktop-runtime',
+    private: true,
+    version: release.version,
+    type: 'module',
+    dependencies: Object.fromEntries(packageSet.packages.map(entry => [entry.name, entry.version])),
+  }, null, 2)}\n`)
+
+  // Manifests are rewritten asynchronously and the descriptor's integrity hashes cover their
+  // bytes, so both steps must settle before the runtime is sealed and checked.
+  await prepareRuntimeManifests(DSH_OUTPUT_ROOT)
+  writeDesktopRuntime(DSH_OUTPUT_ROOT, release, packageSet.packages.map(entry => entry.name), target)
+  await verifyDesktopRuntime(DSH_OUTPUT_ROOT, release.version, target)
+
+  rmSync(DSH_TEMP_BUILD, { recursive: true, force: true })
+  rmSync(PNPM_BUILD_STATE, { recursive: true, force: true })
+}
+
+console.log('==> 8. Configuring electron-builder for Linux (.deb & .AppImage)...')
+const builderConfigFile = join(BUILD_ROOT, 'electron-builder.linux.json')
+// The Desktop Host runs the Office kit CLI as a separate Node process, which cannot read inside an
+// ASAR archive, so every Office package the kit resolves must stay unpacked beside app.asar.
+const officePatterns = (await officePackageDirectories(DSH_OUTPUT_ROOT, { platform: 'linux', arch: 'x64' }))
+  .map(directory => `**/${relative(DSH_OUTPUT_ROOT, directory).split(sep).join('/')}/**/*`)
+// A freedesktop theme only resolves icons from the size directories its index.theme lists, so the
+// single 1104x1104 source would install into an unindexed hicolor/1104x1104/apps and the dock, app
+// grid, and window switcher would all fall back to a generic icon. Rendering the standard sizes
+// gives electron-builder an icon set instead of one image.
+const iconSetDir = join(BUILD_ROOT, 'icons')
+rmSync(iconSetDir, { recursive: true, force: true })
+mkdirSync(iconSetDir, { recursive: true })
+const sharp = desktopRequire('sharp') as (input: string) => {
+  resize: (width: number, height: number) => { png: () => { toFile: (path: string) => Promise<unknown> } }
+}
+for (const size of [16, 24, 32, 48, 64, 128, 256, 512, 1024]) {
+  await sharp(join(DESKTOP_ROOT, 'resources', 'icon.png'))
+    .resize(size, size)
+    .png()
+    .toFile(join(iconSetDir, `${size}x${size}.png`))
+}
+const builderConfig = {
+  appId: 'com.deepseek.harness',
+  productName: 'DeepSeek Harness',
+  protocols: [{ name: 'DeepSeek Harness', schemes: ['dsh'] }],
+  extraMetadata: {
+    dshDesktopAppId: 'com.deepseek.harness',
+    version: dshVersion,
+    // Electron derives app_id/WM_CLASS from desktopName; StartupWMClass then matches the running window.
+    desktopName: 'deepseek-harness',
+    homepage: 'https://github.com/deepseek-ai/deepseek-harness',
+    author: {
+      name: 'DeepSeek',
+      email: 'support@deepseek.com',
+    },
+  },
+  directories: {
+    output: ARTIFACTS_DIR,
+  },
+  asar: true,
+  electronDist: ELECTRON_DIR,
+  electronFuses: { runAsNode: true },
+  files: [
+    'lib/main.js',
+    'lib/welcome/**/*',
+    'lib/preload-app.cjs',
+    'lib/preload-mandatory.cjs',
+    'lib/preload-platform-account.cjs',
+    'lib/preload-update-dialog.cjs',
+    'lib/preload-welcome.cjs',
+    'renderer/**/*',
+    'package.json',
+    { from: DSH_OUTPUT_ROOT, to: 'dsh', filter: ['**/*'] },
+    { from: join(DSH_OUTPUT_ROOT, 'node_modules'), to: 'dsh/node_modules', filter: ['**/*'] },
+  ],
+  asarUnpack: [
+    '**/*.{node,dylib,dll,so,exe}',
+    '**/*.so.*',
+    '**/spawn-helper',
+    '**/@vscode/ripgrep-*/bin/rg',
+    ...officePatterns,
+  ],
+  extraResources: [
+    { from: RUNTIME_ROOT, to: 'runtime' },
+    { from: join(DESKTOP_ROOT, 'resources', 'icon.png'), to: 'icon.png' },
+    // The main process reads this back through process.resourcesPath/tray.png.
+    { from: join(DESKTOP_ROOT, 'resources', 'tray-linux.png'), to: 'tray.png' },
+  ],
+  linux: {
+    executableName: 'deepseek-harness',
+    artifactName: 'deepseek-harness-${version}-${arch}.${ext}',
+    syncDesktopName: true,
+    icon: iconSetDir,
+    category: 'Development',
+    maintainer: 'DeepSeek <support@deepseek.com>',
+    synopsis: 'DeepSeek Harness desktop application',
+    target: ['deb', 'AppImage'],
+  },
+  deb: {
+    packageName: 'deepseek-harness',
+    artifactName: 'deepseek-harness_${version}_${arch}.${ext}',
+    depends: ['libnotify4', 'libxtst6', 'libnss3'],
+  },
+}
+
+writeFileSync(builderConfigFile, `${JSON.stringify(builderConfig, null, 2)}\n`)
+
+console.log('==> 9. Running electron-builder to generate .deb and .AppImage...')
+const buildProc = spawnSync(
+  'pnpm',
+  [
+    '--dir',
+    'apps/desktop',
+    'exec',
+    'electron-builder',
+    '--config',
+    builderConfigFile,
+    '--linux',
+    '--x64',
+    '--publish',
+    'never',
+  ],
+  {
+    cwd: ROOT,
+    stdio: 'inherit',
+    env: { ...process.env },
+  },
+)
+
+if (buildProc.status !== 0) {
+  throw new Error(`electron-builder exited with code ${buildProc.status}`)
+}
+
+console.log('==> Packaging complete! Artifacts in dist/desktop:')
+const artifacts = readdirSync(ARTIFACTS_DIR)
+for (const art of artifacts) {
+  const stat = statSync(join(ARTIFACTS_DIR, art))
+  console.log(`  - ${art} (${(stat.size / 1024 / 1024).toFixed(2)} MB)`)
+}
